//- Previous / next page links at the foot of every page. Parameters: prev, next ({ title, href } or null).
nav(data-docs="pager" aria-label="Previous and next page")
  if prev
    a(href=prev.href rel="prev")
      span(data-docs="pager-label") ← Previous
      span(data-docs="pager-title") {{ prev.title }}
  else
    span
  if next
    a(href=next.href rel="next" data-docs="pager-next")
      span(data-docs="pager-label") Next →
      span(data-docs="pager-title") {{ next.title }}
