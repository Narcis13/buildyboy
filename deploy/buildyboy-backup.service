# Installed to /etc/systemd/system/buildyboy-backup.service by deploy/deploy-wsl.sh.
[Unit]
Description=Buildyboy nightly SQLite backup
After=buildyboy.service

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
Environment=BUILDYBOY_DATA=__DATA_DIR__
Environment=BB_NODE=__NODE__
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/bash __APP_DIR__/deploy/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATA_DIR__
PrivateTmp=yes
