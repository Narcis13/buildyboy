{
  "name": "buildyboy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted software factory around Claude Code",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bb": "cli/bb.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "node server/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "npm run typecheck && vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "simulate": "node scripts/simulate.ts",
    "smoke:claude": "node scripts/smoke-claude.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.17",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
